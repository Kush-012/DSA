collision occurs only when +ve comes before negative

class Solution {
    public int[] asteroidCollision(int[] arr) {
        Stack<Integer>s=new Stack<>();
        for(int i=0;i<arr.length;i++){
            // if pos directly add into stack
            if(arr[i]>0){
                s.push(arr[i]);
            }
            // if neg then fetch prev positive then check
            else{
                int neg=-1;
                // added flag for neg at first index and 3 5 -6 
                // we are not adding -6 remains left so we are using flag for adding
                while(!s.isEmpty() && s.peek()>0){
                    if(Math.abs(s.peek())==Math.abs(arr[i])){
                        s.pop();
                        neg=0;
                        break;
                    }
                    else if(Math.abs(s.peek())>Math.abs(arr[i])){
                        neg=0;
                        break;
                    }
                    else{ 
                        s.pop();
                    }
                }
                if(neg==-1){
                    s.push(arr[i]);
                }
            }
        } 
        int k=0;
        int res[]=new int[s.size()];
        for(int i:s){
            res[k++]=i;
        }
        return res;
    }
}
