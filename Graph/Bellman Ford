import java.util.*;

class Pair {
    int node;
    int weight;

    Pair(int node, int weight) {
        this.node = node;
        this.weight = weight;
    }
}

public class Main {

    public static void bellmanFord(ArrayList<ArrayList<Pair>> graph,
                                   int V, int src) {

        int[] dist = new int[V];

        Arrays.fill(dist, Integer.MAX_VALUE);

        dist[src] = 0;

        for (int i = 1; i <= V - 1; i++) {

            for (int u = 0; u < V; u++) {

                for (Pair p : graph.get(u)) {

                    int v = p.node;
                    int wt = p.weight;

                    if (dist[u] != Integer.MAX_VALUE &&
                            dist[u] + wt < dist[v]) {

                        dist[v] = dist[u] + wt;
                    }
                }
            }
        }

        for (int i = 0; i < V; i++) {
            System.out.println("Distance from " + src +
                    " to " + i + " = " + dist[i]);
        }
    }

    public static void main(String[] args) {

        int V = 5;

        ArrayList<ArrayList<Pair>> graph = new ArrayList<>();

        for (int i = 0; i < V; i++) {
            graph.add(new ArrayList<>());
        }

        graph.get(0).add(new Pair(1, 6));
        graph.get(0).add(new Pair(2, 7));

        graph.get(1).add(new Pair(3, 5));
        graph.get(1).add(new Pair(4, -4));

        graph.get(2).add(new Pair(3, -3));

        graph.get(3).add(new Pair(1, -2));

        bellmanFord(graph, V, 0);
    }
}
